# ==========================================
# HellyAddon Configuration
# ==========================================

# Port the addon listens on (default: 7002)
PORT=7002

# Base URL override (OPTIONAL)
# By default, HellyAddon dynamically detects the public protocol and host
# from incoming HTTP headers (Host, X-Forwarded-Proto, X-Forwarded-Host).
# You only need to set this if you are behind an unusual proxy that rewrites/strips headers:
# BASE_URL=https://helly.yourdomain.com

# Nyaa RSS / Domain mirror (default: https://nyaa.iss.one)
NYAA_DOMAIN=https://nyaa.iss.one

# Anime Garden API endpoint (default: https://api.animes.garden)
ANIME_GARDEN_URL=https://api.animes.garden

# StremThru fallback instance (default: https://st.alext.uk)
STREMTHRU_URL=https://st.alext.uk

# FlareSolverr URL (OPTIONAL, for bypassing Cloudflare on Nyaa if needed)
# FLARESOLVERR_URL=http://localhost:8191/v1
